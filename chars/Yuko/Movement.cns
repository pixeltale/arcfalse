; Air Dash Back
[Statedef 61]
type    = A
physics = A
anim = 160
sprpriority = 1
ctrl = 0
velset = 0, -4

[State 0, AssertSpecial]
type = AssertSpecial
trigger1 = time <= 20
flag = noairguard

[State 100, 1]
type = VelSet
trigger1 = time = 0
x = -4.25

[State Limiter]
type = mapadd
trigger1 = time = 0
map = "ADash"
value = -1
[State Category]
type = mapset
trigger1 = time = 0
map = "DJCL"
value = -1

[State 0, CtrlSet]
type = CtrlSet
trigger1 = time = 4
value = 1

